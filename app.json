{
  "expo": {
    "name": "Cakalearn",
    "slug": "cakalearn",
    "owner": "cakale",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cakalearn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cakalearn.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cakalearn needs your location to record attendance and verify you are clocking in from the correct site.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Cakalearn needs your location to record attendance and verify you are clocking in from the correct site."
      }
    },
    "android": {
      "package": "com.cakalearn.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Cakalearn needs camera access to record you during proctored assessments.",
          "microphonePermission": "Cakalearn needs microphone access to record audio during proctored assessments.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cakalearn needs your location to record attendance and verify you are clocking in from the correct site."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#4C3FC4",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 280,
            "backgroundColor": "#4C3FC4"
          }
        }
      ],
      "expo-video",
      "./plugins/withDetoxAndroid.js",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec70cce6-f498-4205-b1c9-5244f5d52cfd"
      }
    }
  }
}
